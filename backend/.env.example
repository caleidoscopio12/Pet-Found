# Puerto de la API
PORT=4000

# Origen(es) permitidos por CORS (separar con comas si son varios)
CORS_ORIGIN=http://localhost:5173

# MongoDB Atlas — el usuario necesita rol readWrite sobre la base "mascotas".
# Recuerda permitir tu IP en Atlas → Network Access.
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/mascotas?retryWrites=true&w=majority

# Cloudinary (Dashboard → API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
