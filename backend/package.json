{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "description": "API REST de la app de mascotas perdidas (Express).",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test \"test/**/*.test.js\" \"src/**/*.test.js\"",
    "test:modelo": "node --test \"test-modelo/**/*.test.js\"",
    "db:seed": "node scripts/seed.js",
    "db:indices": "node scripts/verificar-indices.js",
    "db:indice-vectorial": "node scripts/indice-vectorial.js",
    "db:embeddings": "node scripts/embeddings.js",
    "db:similares": "node scripts/similares.js",
    "db:calibrar": "node scripts/calibrar.js"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "mongoose": "^9.12.0",
    "multer": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1"
  }
}
