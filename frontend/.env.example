# URL base de la API (backend Express)
VITE_API_URL=http://localhost:4000/api

# Centro por defecto del mapa (Constitución, Región del Maule)
VITE_DEFAULT_LAT=-35.333
VITE_DEFAULT_LNG=-72.416

# Teselas CARTO Voyager. Key gratis para proyectos sin fines de lucro (hasta 5M teselas/mes):
# https://carto.com/basemaps/apikey  — si se deja vacía, el mapa usa OSM estándar.
VITE_CARTO_API_KEY=
